@addMethod(PauseMenuGameController)
function NCCInventoryActionDetail(label: String, category: String) -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  entries = NCCCatalog.Actions();
  if (this.nccBrowserSelected >= 0 && this.nccBrowserSelected < entries.Size()) {
    entry = entries[this.nccBrowserSelected];
    if (entry.command == "level cap ") {
      this.NCCCapMenu(label, category);
      return;
    }
    if (entry.command == "level set ") {
      this.NCCLevelMenu(label, category);
      return;
    }
    if (entry.command == "xp add ") {
      this.NCCXPMenu(label, category);
      return;
    }
    if (entry.command == "money add ") {
      this.NCCInventoryMoneyMenu(label, category);
      return;
    }
  }
  this.NCCBrowserPreviewDetail(label, category);
}

@addMethod(PauseMenuGameController)
function NCCInventoryFinishMenu(selection: Int32) -> Void {
  this.AddMenuItem("Back to Catalogue", n"NCCBrowserList");
  this.AddMenuItem("Back to Pause Menu", n"NCCBrowserClose");
  this.m_menuListController.Refresh();
  this.NCCBrowserSelect(selection, true);
}

@addMethod(PauseMenuGameController)
function NCCInventoryRender() -> Void {
  if (this.nccInventoryStage == 1) {
    this.NCCInventoryReview();
    return;
  }
  this.NCCInventoryResult();
}

@addMethod(PauseMenuGameController)
function NCCInventoryReview() -> Void {
  this.Clear();
  this.AddMenuItem(this.nccInventoryLabel, n"NCCBrowserNone");
  this.AddMenuItem(this.nccInventoryCaption, n"NCCBrowserNone");
  this.AddMenuItem("Confirm Change", n"NCCInventoryConfirm");
  this.AddMenuItem("Cancel", n"NCCInventoryCancel");
  this.AddMenuItem("Back to Catalogue", n"NCCBrowserList");
  this.AddMenuItem("Back to Pause Menu", n"NCCBrowserClose");
  this.m_menuListController.Refresh();
  this.NCCBrowserSelect(3, true);
}

@addMethod(PauseMenuGameController)
function NCCInventoryResult() -> Void {
  this.Clear();
  this.AddMenuItem(this.nccInventoryNotice, n"NCCBrowserNone");
  this.AddMenuItem(this.nccInventoryLabel, n"NCCBrowserNone");
  this.AddMenuItem("Back to Options", n"NCCInventoryReturn");
  this.AddMenuItem("Back to Catalogue", n"NCCBrowserList");
  this.AddMenuItem("Back to Pause Menu", n"NCCBrowserClose");
  this.m_menuListController.Refresh();
  this.NCCBrowserSelect(2, true);
}

@addMethod(PauseMenuGameController)
function NCCInventoryConfirm() -> Void {
  let accepted: Bool;
  if (this.nccCapQueued) {
    if (this.nccInventoryStage != 1) { return; }
    this.nccInventoryStage = 2;
    this.nccCapQueued = false;
    this.NCCCapApply(this.nccInventoryAmount);
    this.nccInventoryAmount = 0;
    this.NCCBrowserRender();
    return;
  }
  if (this.nccLevelQueued) {
    if (this.nccInventoryStage != 1) { return; }
    this.nccInventoryStage = 2;
    this.nccLevelQueued = false;
    this.NCCLevelApply(this.nccInventoryAmount);
    this.nccInventoryAmount = 0;
    this.NCCBrowserRender();
    return;
  }
  if (this.nccXPQueued) {
    if (this.nccInventoryStage != 1) { return; }
    this.nccInventoryStage = 2;
    this.nccXPQueued = false;
    this.NCCXPApply(this.nccInventoryAmount);
    this.nccInventoryAmount = 0;
    this.NCCBrowserRender();
    return;
  }
  if (this.nccInventoryStage != 1) { return; }
  this.nccInventoryStage = 2;
  accepted = this.NCCInventoryApply(this.nccInventoryId, this.nccInventoryAmount);
  this.nccInventoryId = "";
  this.nccInventoryAmount = 0;
  if (accepted) {
    this.nccInventoryNotice = "Grant accepted by the game.";
  } else {
    this.nccInventoryNotice = "Grant failed. Item, player, or inventory unavailable.";
  }
  this.NCCBrowserRender();
}

@addMethod(PauseMenuGameController)
function NCCInventoryApply(recordName: String, amount: Int32) -> Bool {
  let owner: GameObject;
  let transaction: TransactionSystem;
  let id: TweakDBID;
  let current: Int32;
  if (amount <= 0 || amount > 1000000 || recordName == "") { return false; }
  owner = this.GetPlayerControlledObject();
  if (owner) {
    id = TDBID.Create(recordName);
    if (TweakDBInterface.GetItemRecord(id)) {
      transaction = GameInstance.GetTransactionSystem(owner.GetGame());
      if (transaction) {
        current = transaction.GetItemQuantity(owner, ItemID.FromTDBID(id));
        if (current < 0 || current > 2000000000 - amount) { return false; }
        return transaction.GiveItemByTDBID(owner, id, amount);
      }
    }
  }
  return false;
}

@addMethod(PauseMenuGameController)
function NCCBrowserSelect(selection: Int32, force: Bool) -> Void {
  this.m_menuListController.SetSelectedIndex(selection, force);
  this.SetCursorOverWidget(this.m_menuListController.GetItemAt(selection), 0.00, true);
}

@addMethod(PauseMenuGameController)
function NCCXPHandle(route: CName) -> Bool {
  if (this.nccInventoryStage > 0) { return false; }
  if (route == n"NCCXP1000") { this.NCCXPRequest(1000, "Add 1,000 XP"); return true; }
  if (route == n"NCCXP5000") { this.NCCXPRequest(5000, "Add 5,000 XP"); return true; }
  if (route == n"NCCXP10000") { this.NCCXPRequest(10000, "Add 10,000 XP"); return true; }
  if (route == n"NCCXP50000") { this.NCCXPRequest(50000, "Add 50,000 XP"); return true; }
  return false;
}

@addMethod(PauseMenuGameController)
function NCCXPRequest(amount: Int32, caption: String) -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  if (this.nccInventoryStage != 0 || this.nccBrowserMode != 1 || !this.nccBrowserDetail) { return; }
  if (amount != 1000 && amount != 5000 && amount != 10000 && amount != 50000) { return; }
  entries = NCCCatalog.Actions();
  if (this.nccBrowserSelected < 0 || this.nccBrowserSelected >= entries.Size()) { return; }
  entry = entries[this.nccBrowserSelected];
  if (entry.command != "xp add ") { return; }
  this.nccXPQueued = true;
  this.nccInventoryId = "";
  this.nccInventoryLabel = entry.label;
  this.nccInventoryAmount = amount;
  this.nccInventoryCaption = caption;
  this.nccInventoryStage = 1;
  this.NCCBrowserRender();
}

@addMethod(PauseMenuGameController)
function NCCXPMenu(label: String, category: String) -> Void {
  this.Clear();
  this.AddMenuItem(label, n"NCCBrowserNone");
  this.AddMenuItem("Category: " + category, n"NCCBrowserNone");
  this.AddMenuItem("Add 1,000 XP", n"NCCXP1000");
  this.AddMenuItem("Add 5,000 XP", n"NCCXP5000");
  this.AddMenuItem("Add 10,000 XP", n"NCCXP10000");
  this.AddMenuItem("Add 50,000 XP", n"NCCXP50000");
  this.NCCInventoryFinishMenu(2);
}

@addMethod(PauseMenuGameController)
function NCCXPApply(amount: Int32) -> Void {
  let owner: GameObject;
  let development: PlayerDevelopmentData;
  let current: Int32;
  let cap: Int32;
  let beforeXP: Int32;
  let afterXP: Int32;
  let afterLevel: Int32;
  this.nccInventoryNotice = "XP grant refused. Check the level cap, amount, and player.";
  if (amount != 1000 && amount != 5000 && amount != 10000 && amount != 50000) { return; }
  owner = this.GetPlayerControlledObject();
  if (owner) {
    development = PlayerDevelopmentSystem.GetData(owner);
    if (development) {
      current = development.GetProficiencyLevel(gamedataProficiencyType.Level);
      cap = development.GetProficiencyAbsoluteMaxLevel(gamedataProficiencyType.Level);
      beforeXP = development.GetCurrentLevelProficiencyExp(gamedataProficiencyType.Level);
      if (current >= 1 && current < cap && beforeXP >= 0 && beforeXP <= 2000000000 - amount) {
        development.AddExperience(amount, gamedataProficiencyType.Level, telemetryLevelGainReason.IsDebug, false);
        afterXP = development.GetCurrentLevelProficiencyExp(gamedataProficiencyType.Level);
        afterLevel = development.GetProficiencyLevel(gamedataProficiencyType.Level);
        this.nccInventoryNotice = "XP requested. No change detected yet.";
        if (afterXP != beforeXP || afterLevel != current) {
          this.nccInventoryNotice = "Progress updated after the XP grant.";
        }
      }
    }
  }
}

@addMethod(PauseMenuGameController)
function NCCLevelHandle(route: CName) -> Bool {
  if (this.nccInventoryStage > 0) { return false; }
  if (route == n"NCCLevel1") { this.NCCLevelRequest(1, "Gain 1 level, up to the current cap."); return true; }
  if (route == n"NCCLevel5") { this.NCCLevelRequest(5, "Gain 5 levels, up to the current cap."); return true; }
  if (route == n"NCCLevel10") { this.NCCLevelRequest(10, "Gain 10 levels, up to the current cap."); return true; }
  if (route == n"NCCLevelMax") { this.NCCLevelRequest(0, "Reach the current level cap."); return true; }
  return false;
}

@addMethod(PauseMenuGameController)
function NCCLevelRequest(delta: Int32, caption: String) -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  if (this.nccInventoryStage != 0 || this.nccBrowserMode != 1 || !this.nccBrowserDetail) { return; }
  if (delta != 0 && delta != 1 && delta != 5 && delta != 10) { return; }
  entries = NCCCatalog.Actions();
  if (this.nccBrowserSelected < 0 || this.nccBrowserSelected >= entries.Size()) { return; }
  entry = entries[this.nccBrowserSelected];
  if (entry.command != "level set ") { return; }
  this.nccLevelQueued = true;
  this.nccInventoryId = "";
  this.nccInventoryLabel = entry.label;
  this.nccInventoryAmount = delta;
  this.nccInventoryCaption = caption;
  this.nccInventoryStage = 1;
  this.NCCBrowserRender();
}

@addMethod(PauseMenuGameController)
function NCCLevelMenu(label: String, category: String) -> Void {
  this.Clear();
  this.AddMenuItem(label, n"NCCBrowserNone");
  this.AddMenuItem("Category: " + category, n"NCCBrowserNone");
  this.AddMenuItem("Gain 1 Level", n"NCCLevel1");
  this.AddMenuItem("Gain 5 Levels", n"NCCLevel5");
  this.AddMenuItem("Gain 10 Levels", n"NCCLevel10");
  this.AddMenuItem("Reach Current Level Cap", n"NCCLevelMax");
  this.NCCInventoryFinishMenu(2);
}

@addMethod(PauseMenuGameController)
function NCCLevelApply(delta: Int32) -> Void {
  let owner: GameObject;
  let development: PlayerDevelopmentData;
  let current: Int32;
  let cap: Int32;
  let target: Int32;
  let observed: Int32;
  this.nccInventoryNotice = "Level gain refused. Check the cap, amount, and player.";
  if (delta != 0 && delta != 1 && delta != 5 && delta != 10) { return; }
  owner = this.GetPlayerControlledObject();
  if (owner) {
    development = PlayerDevelopmentSystem.GetData(owner);
    if (development) {
      current = development.GetProficiencyLevel(gamedataProficiencyType.Level);
      cap = development.GetProficiencyAbsoluteMaxLevel(gamedataProficiencyType.Level);
      if (current >= 1 && current < cap) {
        target = cap;
        if (delta > 0 && delta < cap - current) {
          target = current + delta;
        }
        development.SetLevel(gamedataProficiencyType.Level, target, telemetryLevelGainReason.IsDebug, false);
        observed = development.GetProficiencyLevel(gamedataProficiencyType.Level);
        this.nccInventoryNotice = "The game has not confirmed the requested level yet.";
        if (observed == target) {
          this.nccInventoryNotice = "Requested level reached.";
        }
      }
    }
  }
}

@addMethod(PauseMenuGameController)
function NCCCapHandle(route: CName) -> Bool {
  if (this.nccInventoryStage > 0) { return false; }
  if (route == n"NCCCap80") { this.NCCCapRequest(80, "Level cap 80. Unlocks further progression."); return true; }
  if (route == n"NCCCap100") { this.NCCCapRequest(100, "Level cap 100. Unlocks further progression."); return true; }
  if (route == n"NCCCapNative") { this.NCCCapRequest(0, "Restore the original cap if your level allows it."); return true; }
  return false;
}

@addMethod(PauseMenuGameController)
function NCCCapRequest(cap: Int32, caption: String) -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  if (this.nccInventoryStage != 0 || this.nccBrowserMode != 1 || !this.nccBrowserDetail) { return; }
  if (cap != 0 && cap != 80 && cap != 100) { return; }
  entries = NCCCatalog.Actions();
  if (this.nccBrowserSelected < 0 || this.nccBrowserSelected >= entries.Size()) { return; }
  entry = entries[this.nccBrowserSelected];
  if (entry.command != "level cap ") { return; }
  this.nccCapQueued = true;
  this.nccInventoryId = "";
  this.nccInventoryLabel = entry.label;
  this.nccInventoryAmount = cap;
  this.nccInventoryCaption = caption;
  this.nccInventoryStage = 1;
  this.NCCBrowserRender();
}

@addMethod(PauseMenuGameController)
function NCCCapMenu(label: String, category: String) -> Void {
  this.Clear();
  this.AddMenuItem(label, n"NCCBrowserNone");
  this.AddMenuItem("Category: " + category, n"NCCBrowserNone");
  this.AddMenuItem("You can restore the original cap if your level is within it.", n"NCCBrowserNone");
  this.AddMenuItem("Set Level Cap to 80", n"NCCCap80");
  this.AddMenuItem("Set Level Cap to 100", n"NCCCap100");
  this.AddMenuItem("Restore Original Level Cap", n"NCCCapNative");
  this.NCCInventoryFinishMenu(3);
}

@addMethod(PauseMenuGameController)
function NCCCapApply(cap: Int32) -> Void {
  let owner: GameObject;
  let development: PlayerDevelopmentData;
  let quests: QuestsSystem;
  let current: Int32;
  let normal: Int32;
  let target: Int32;
  this.nccInventoryNotice = "Cap change refused. Invalid value or player unavailable.";
  if (cap != 0 && cap != 80 && cap != 100) { return; }
  owner = this.GetPlayerControlledObject();
  if (owner) {
    development = PlayerDevelopmentSystem.GetData(owner);
    quests = GameInstance.GetQuestsSystem(owner.GetGame());
    if (development && quests && NCCCapSettings.Allowed(owner)) {
      normal = NCCCapSettings.NativeCap();
      current = development.GetProficiencyLevel(gamedataProficiencyType.Level);
      target = cap;
      if (cap == 0) { target = normal; }
      this.nccInventoryNotice = "The new cap must cover your current level and the original cap.";
      if (normal >= 1 && current >= 1 && target >= normal && target >= current) {
        quests.SetFact(n"ncc_console_level_cap_v2", cap);
        this.nccInventoryNotice = "The game did not confirm the cap change.";
        if (quests.GetFact(n"ncc_console_level_cap_v2") == cap) {
          development.NCCCapRefresh();
          if (development.GetProficiencyAbsoluteMaxLevel(gamedataProficiencyType.Level) == target) {
            this.nccInventoryNotice = "Level cap saved. Your current level stays the same.";
          }
        }
      }
    }
  }
}

// NCC_CAP_NATIVE_BEGIN
@wrapMethod(PlayerDevelopmentData)
const function GetProficiencyAbsoluteMaxLevel(type: gamedataProficiencyType) -> Int32 {
  let normal: Int32;
  let cap: Int32;
  normal = GetProficiencyAbsoluteMaxLevel(type);
  if (type == gamedataProficiencyType.Level && normal >= 1) {
    cap = NCCCapSettings.Configured(this.GetOwner());
    if (cap > normal) { return cap; }
  }
  return normal;
}

@wrapMethod(PlayerDevelopmentData)
const function GetProficiencyMaxLevel(type: gamedataProficiencyType) -> Int32 {
  let normal: Int32;
  let cap: Int32;
  normal = GetProficiencyMaxLevel(type);
  if (type == gamedataProficiencyType.Level && normal >= 1) {
    cap = NCCCapSettings.Configured(this.GetOwner());
    if (cap > normal) { return cap; }
  }
  return normal;
}

@wrapMethod(PlayerDevelopmentData)
const function IsProficiencyMaxLvl(type: gamedataProficiencyType) -> Bool {
  let cap: Int32;
  let normal: Int32;
  if (type == gamedataProficiencyType.Level) {
    cap = NCCCapSettings.Configured(this.GetOwner());
    if (cap > 0) {
      normal = NCCCapSettings.NativeCap();
      if (normal >= 1 && cap >= normal) {
        return this.GetProficiencyLevel(type) >= cap;
      }
    }
  }
  return IsProficiencyMaxLvl(type);
}

@wrapMethod(PlayerDevelopmentData)
const function GetExperienceForNextLevel(type: gamedataProficiencyType) -> Int32 {
  let cap: Int32;
  let normal: Int32;
  let current: Int32;
  if (type == gamedataProficiencyType.Level) {
    cap = NCCCapSettings.Configured(this.GetOwner());
    if (cap > 0) {
      normal = NCCCapSettings.NativeCap();
      current = this.GetProficiencyLevel(type);
      if (normal >= 1 && cap > normal && current >= normal) {
        if (current >= cap) { return -1; }
        return 50000 + (current - normal) * 2500;
      }
    }
  }
  return GetExperienceForNextLevel(type);
}

@wrapMethod(PlayerDevelopmentData)
const function GetDevPointsForLevel(level: Int32, profType: gamedataProficiencyType, devPtsType: gamedataDevelopmentPointType) -> Int32 {
  let cap: Int32;
  let normal: Int32;
  if (profType == gamedataProficiencyType.Level) {
    cap = NCCCapSettings.Configured(this.GetOwner());
    if (cap > 0) {
      normal = NCCCapSettings.NativeCap();
      if (normal >= 1 && cap > normal && level > normal && level <= cap) {
        if (devPtsType == gamedataDevelopmentPointType.Primary) { return 1; }
        if (devPtsType == gamedataDevelopmentPointType.Attribute && level % 2 == 0) { return 1; }
        return 0;
      }
    }
  }
  return GetDevPointsForLevel(level, profType, devPtsType);
}

@addMethod(PlayerDevelopmentData)
function NCCCapRefresh() -> Void {
  this.UpdateProficiencyMaxLevels();
  this.UpdateUIBB();
}
