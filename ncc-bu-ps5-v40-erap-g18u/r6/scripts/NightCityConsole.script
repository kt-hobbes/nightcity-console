  public static function Actions() -> array<NCCAction> {
    let entries: array<NCCAction>;
    let remaining: array<NCCAction>;
    let i: Int32;
    entries = NCCCatalog.ActionsFirst();
    remaining = NCCCatalog.ActionsSecond();
    i = 0;
    while (i < remaining.Size()) {
      entries.PushBack(remaining[i]);
      i += 1;
    }
    return entries;
  }
