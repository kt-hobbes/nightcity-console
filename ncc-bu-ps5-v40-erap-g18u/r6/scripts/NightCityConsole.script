// Catalogue browser: item and money additions require explicit confirmation.
// Save-scoped opt-in. No change without the console's dedicated fact.
public class NCCCapSettings extends IScriptable {
  public static function Allowed(owner: GameObject) -> Bool {
    let player: PlayerPuppet;
    player = owner as PlayerPuppet;
    if (player) {
      return player.IsPlayerControlled() && !player.IsReplacer();
    }
    return false;
  }

  public static function NativeCap() -> Int32 {
    let proficiencyRecord: Proficiency_Record;
    proficiencyRecord = RPGManager.GetProficiencyRecord(gamedataProficiencyType.Level);
    if (proficiencyRecord) { return proficiencyRecord.MaxLevel(); }
    return 0;
  }

  public static function Configured(owner: GameObject) -> Int32 {
    let quests: QuestsSystem;
    let cap: Int32;
    if (owner) {
      if (NCCCapSettings.Allowed(owner)) {
        quests = GameInstance.GetQuestsSystem(owner.GetGame());
        if (quests) {
          cap = quests.GetFact(n"ncc_console_level_cap_v2");
          if (cap == 80 || cap == 100) { return cap; }
        }
      }
    }
    return 0;
  }
}


@addField(PauseMenuGameController)
let nccBrowserMode: Int32;
@addField(PauseMenuGameController)
let nccBrowserOffset: Int32;
@addField(PauseMenuGameController)
let nccBrowserCount: Int32;
@addField(PauseMenuGameController)
let nccBrowserSelected: Int32;
@addField(PauseMenuGameController)
let nccBrowserDetail: Bool;

// First inventory features. State is transient and cleared with the pause menu.
@addField(PauseMenuGameController)
let nccInventoryStage: Int32;
@addField(PauseMenuGameController)
let nccInventoryId: String;
@addField(PauseMenuGameController)
let nccInventoryLabel: String;
@addField(PauseMenuGameController)
let nccInventoryAmount: Int32;
@addField(PauseMenuGameController)
let nccInventoryCaption: String;
@addField(PauseMenuGameController)
let nccInventoryNotice: String;


// XP only. Native object access stays local, as in the compiled BB probe.
@addField(PauseMenuGameController)
let nccXPQueued: Bool;


// Upward level changes only, using the game's current cap and reward path.
@addField(PauseMenuGameController)
let nccLevelQueued: Bool;


@addField(PauseMenuGameController)
let nccCapQueued: Bool;


@wrapMethod(PauseMenuGameController)
function PopulateMenuItemList() -> Void {
  PopulateMenuItemList();
  this.NCCInventoryReset();
  this.nccBrowserMode = 0;
  this.nccBrowserOffset = 0;
  this.nccBrowserDetail = false;
  this.AddMenuItem("Night City Console", n"NCCBrowserOpen");
  this.m_menuListController.Refresh();
}

@wrapMethod(PauseMenuGameController)
event OnMenuItemActivated(index: Int32, target: ListItemController) -> Void {
  let data: PauseMenuListItemData;
  if (target) {
    data = target.GetData() as PauseMenuListItemData;
    if (data) {
      if (this.NCCBrowserHandle(data.eventName, index)) {
        return;
      }
    }
  }
  OnMenuItemActivated(index, target);
}

@wrapMethod(PauseMenuGameController)
event OnUninitialize() -> Void {
  this.NCCInventoryReset();
  this.nccBrowserMode = 0;
  this.nccBrowserOffset = 0;
  this.nccBrowserCount = 0;
  this.nccBrowserDetail = false;
  OnUninitialize();
}

@wrapMethod(PauseMenuGameController)
event OnRedrawRequested() -> Void {
  if (this.nccBrowserMode > 0) {
    this.NCCBrowserRender();
    return;
  }
  OnRedrawRequested();
}

@addMethod(PauseMenuGameController)
function NCCBrowserHandle(route: CName, index: Int32) -> Bool {
  if (this.NCCInventoryHandle(route)) { return true; }
  if (route == n"NCCBrowserOpen") {
    this.nccBrowserMode = 1;
    this.nccBrowserOffset = 0;
    this.nccBrowserDetail = false;
    this.NCCBrowserRender();
    return true;
  }
  if (this.nccBrowserMode == 0) {
    return false;
  }
  if (route == n"NCCBrowserClose") {
    this.nccBrowserMode = 0;
    this.nccBrowserDetail = false;
    this.ShowActionsList();
    this.NCCBrowserSelect(0, true);
    return true;
  }
  if (route == n"NCCBrowserNone") {
    return true;
  }
  if (route == n"NCCBrowserEntry") {
    if (!this.nccBrowserDetail && index >= 1 && index <= 4) {
      this.nccBrowserSelected = this.nccBrowserOffset + index - 1;
      if (this.nccBrowserSelected < this.nccBrowserCount) {
        this.nccBrowserDetail = true;
        this.NCCBrowserRender();
      }
    }
    return true;
  }
  return this.NCCBrowserNavigate(route);
}

@addMethod(PauseMenuGameController)
function NCCBrowserNavigate(route: CName) -> Bool {
  if (route == n"NCCBrowserList") {
    this.nccBrowserDetail = false;
  } else {
    if (route == n"NCCBrowserSwitch") {
      if (this.nccBrowserMode == 1) {
        this.nccBrowserMode = 2;
      } else {
        this.nccBrowserMode = 1;
      }
      this.nccBrowserOffset = 0;
      this.nccBrowserDetail = false;
    } else {
      if (route == n"NCCBrowserNext") {
        if (this.nccBrowserOffset + 4 < this.nccBrowserCount) {
          this.nccBrowserOffset += 4;
        }
      } else {
        if (route == n"NCCBrowserPrevious") {
          if (this.nccBrowserOffset >= 4) {
            this.nccBrowserOffset -= 4;
          }
        } else {
          return false;
        }
      }
    }
  }
  this.NCCBrowserRender();
  if (route == n"NCCBrowserList" && this.nccBrowserSelected >= this.nccBrowserOffset && this.nccBrowserSelected < this.nccBrowserOffset + 4 && this.nccBrowserSelected < this.nccBrowserCount) {
    this.NCCBrowserSelect(this.nccBrowserSelected - this.nccBrowserOffset + 1, true);
  }
  return true;
}

@addMethod(PauseMenuGameController)
function NCCBrowserRender() -> Void {
  if (!this.m_menuListController || this.nccBrowserMode == 0) {
    return;
  }
  if (this.nccInventoryStage > 0) {
    this.NCCInventoryRender();
    return;
  }
  if (this.nccBrowserMode == 1) {
    this.NCCBrowserRenderActions();
    return;
  }
  this.NCCBrowserRenderItems();
}

@addMethod(PauseMenuGameController)
function NCCBrowserFooter(total: Int32) -> Void {
  if (this.nccBrowserOffset > 0) {
    this.AddMenuItem("Previous Page", n"NCCBrowserPrevious");
  }
  if (this.nccBrowserOffset + 4 < total) {
    this.AddMenuItem("Next Page", n"NCCBrowserNext");
  }
  this.AddMenuItem("Back to Pause Menu", n"NCCBrowserClose");
  this.m_menuListController.Refresh();
  if (total > 0) {
    this.NCCBrowserSelect(1, true);
  } else {
    this.NCCBrowserSelect(0, true);
  }
}

@addMethod(PauseMenuGameController)
function NCCBrowserShowDetail(label: String, category: String) -> Void {
  if (this.nccBrowserMode == 2) {
    this.NCCInventoryItemMenu(label, category);
    return;
  }
  if (this.nccBrowserMode == 1) {
    this.NCCInventoryActionDetail(label, category);
    return;
  }
  this.NCCBrowserPreviewDetail(label, category);
}

@addMethod(PauseMenuGameController)
function NCCBrowserBegin(total: Int32, heading: String) -> Void {
  if (this.nccBrowserOffset < 0 || this.nccBrowserOffset >= total) {
    this.nccBrowserOffset = 0;
  }
  this.Clear();
  this.AddMenuItem(heading, n"NCCBrowserSwitch");
}

@addMethod(PauseMenuGameController)
function NCCBrowserRenderActions() -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  let total: Int32;
  let i: Int32;
  let last: Int32;
  entries = NCCCatalog.Actions();
  total = entries.Size();
  this.nccBrowserCount = total;
  if (this.nccBrowserDetail) {
    if (this.nccBrowserSelected >= 0 && this.nccBrowserSelected < total) {
      entry = entries[this.nccBrowserSelected];
      this.NCCBrowserShowDetail(entry.label, entry.category);
      return;
    }
    this.nccBrowserDetail = false;
  }
  this.NCCBrowserBegin(total, "Actions | Browse Items");
  i = this.nccBrowserOffset;
  last = i + 4;
  if (last > total) { last = total; }
  while (i < last) {
    entry = entries[i];
    this.AddMenuItem(entry.label, n"NCCBrowserEntry");
    i += 1;
  }
  this.NCCBrowserFooter(total);
}

@addMethod(PauseMenuGameController)
function NCCBrowserRenderItems() -> Void {
  let entries: array<NCCItem>;
  let entry: NCCItem;
  let total: Int32;
  let i: Int32;
  let last: Int32;
  entries = NCCCatalog.Items();
  total = entries.Size();
  this.nccBrowserCount = total;
  if (this.nccBrowserDetail) {
    if (this.nccBrowserSelected >= 0 && this.nccBrowserSelected < total) {
      entry = entries[this.nccBrowserSelected];
      this.NCCBrowserShowDetail(entry.label, entry.category);
      return;
    }
    this.nccBrowserDetail = false;
  }
  this.NCCBrowserBegin(total, "Items | Browse Actions");
  i = this.nccBrowserOffset;
  last = i + 4;
  if (last > total) { last = total; }
  while (i < last) {
    entry = entries[i];
    this.AddMenuItem(entry.label, n"NCCBrowserEntry");
    i += 1;
  }
  this.NCCBrowserFooter(total);
}

@addMethod(PauseMenuGameController)
function NCCBrowserPreviewDetail(label: String, category: String) -> Void {
  this.Clear();
  this.AddMenuItem(label, n"NCCBrowserNone");
  this.AddMenuItem("Category: " + category, n"NCCBrowserNone");
  this.AddMenuItem("Preview only. This action is unavailable.", n"NCCBrowserNone");
  this.AddMenuItem("Back to Catalogue", n"NCCBrowserList");
  this.AddMenuItem("Back to Pause Menu", n"NCCBrowserClose");
  this.m_menuListController.Refresh();
  this.NCCBrowserSelect(3, true);
}

@addMethod(PauseMenuGameController)
function NCCInventoryReset() -> Void {
  this.nccCapQueued = false;
  this.nccLevelQueued = false;
  this.nccXPQueued = false;
  this.nccInventoryStage = 0;
  this.nccInventoryId = "";
  this.nccInventoryLabel = "";
  this.nccInventoryAmount = 0;
  this.nccInventoryCaption = "";
  this.nccInventoryNotice = "";
}

@addMethod(PauseMenuGameController)
function NCCInventoryHandle(route: CName) -> Bool {
  if (this.NCCCapHandle(route)) { return true; }
  if (this.NCCLevelHandle(route)) { return true; }
  if (this.NCCXPHandle(route)) { return true; }
  if (route == n"NCCInventoryConfirm") {
    this.NCCInventoryConfirm();
    return true;
  }
  if (route == n"NCCInventoryCancel" || route == n"NCCInventoryReturn") {
    if (this.nccInventoryStage > 0) {
      this.NCCInventoryReset();
      this.NCCBrowserRender();
    }
    return true;
  }
  if (route == n"NCCBrowserClose" || route == n"NCCBrowserList") {
    this.NCCInventoryReset();
    return false;
  }
  if (this.nccInventoryStage > 0) {
    return true;
  }
  return this.NCCInventoryHandleQuantity(route);
}

@addMethod(PauseMenuGameController)
function NCCInventoryHandleQuantity(route: CName) -> Bool {
  if (route == n"NCCItem1") { this.NCCInventoryRequest(1, "Quantity: 1"); return true; }
  if (route == n"NCCItem5") { this.NCCInventoryRequest(5, "Quantity: 5"); return true; }
  if (route == n"NCCItem10") { this.NCCInventoryRequest(10, "Quantity: 10"); return true; }
  if (route == n"NCCItem100") { this.NCCInventoryRequest(100, "Quantity: 100"); return true; }
  if (route == n"NCCMoney1000") { this.NCCInventoryRequest(1000, "Amount: 1,000 eurodollars"); return true; }
  if (route == n"NCCMoney10000") { this.NCCInventoryRequest(10000, "Amount: 10,000 eurodollars"); return true; }
  if (route == n"NCCMoney100000") { this.NCCInventoryRequest(100000, "Amount: 100,000 eurodollars"); return true; }
  if (route == n"NCCMoney1000000") { this.NCCInventoryRequest(1000000, "Amount: 1,000,000 eurodollars"); return true; }
  return false;
}

@addMethod(PauseMenuGameController)
function NCCInventoryRequest(amount: Int32, caption: String) -> Void {
  if (this.nccInventoryStage != 0 || !this.nccBrowserDetail) { return; }
  if (this.nccBrowserMode == 2) {
    this.NCCInventoryPrepareItem(amount, caption);
    return;
  }
  if (this.nccBrowserMode == 1) {
    this.NCCInventoryPrepareMoney(amount, caption);
  }
}

@addMethod(PauseMenuGameController)
function NCCInventoryPrepareItem(amount: Int32, caption: String) -> Void {
  let entries: array<NCCItem>;
  let entry: NCCItem;
  if (amount != 1 && amount != 5 && amount != 10 && amount != 100) { return; }
  entries = NCCCatalog.Items();
  if (this.nccBrowserSelected < 0 || this.nccBrowserSelected >= entries.Size()) { return; }
  entry = entries[this.nccBrowserSelected];
  this.nccInventoryId = entry.id;
  this.nccInventoryLabel = entry.label;
  this.nccInventoryAmount = amount;
  this.nccInventoryCaption = caption;
  this.nccInventoryStage = 1;
  this.NCCBrowserRender();
}

@addMethod(PauseMenuGameController)
function NCCInventoryPrepareMoney(amount: Int32, caption: String) -> Void {
  let entries: array<NCCAction>;
  let entry: NCCAction;
  if (amount != 1000 && amount != 10000 && amount != 100000 && amount != 1000000) { return; }
  entries = NCCCatalog.Actions();
  if (this.nccBrowserSelected < 0 || this.nccBrowserSelected >= entries.Size()) { return; }
  entry = entries[this.nccBrowserSelected];
  if (entry.command != "money add ") { return; }
  this.nccInventoryId = "Items.money";
  this.nccInventoryLabel = "Eurodollars";
  this.nccInventoryAmount = amount;
  this.nccInventoryCaption = caption;
  this.nccInventoryStage = 1;
  this.NCCBrowserRender();
}

